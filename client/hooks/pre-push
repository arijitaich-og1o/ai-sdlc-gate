#!/usr/bin/env bash
# SDLC Gate — local push gate (advisory fast feedback).
#
# For every branch being pushed, reviews the commits that are new to the remote with the intent derived from
# the branch name / trailers (release/*, hotfix/* -> deployment phases, ...). The server-side gate remains
# authoritative. Chains to the repository's own .git/hooks/pre-push if present.
set -u

SDLC_HOME="${SDLC_GATE_HOME:-$HOME/.sdlc-gate}"
REMOTE_NAME="$1"
ZERO="0000000000000000000000000000000000000000"

INPUT="$(cat)"

LOCAL_HOOK="$(git rev-parse --git-path hooks 2>/dev/null)/pre-push"
if [ -x "$LOCAL_HOOK" ] && [ "$LOCAL_HOOK" != "$0" ]; then
  printf '%s\n' "$INPUT" | "$LOCAL_HOOK" "$@" || exit $?
fi

[ "${SDLC_GATE_LOCAL_PUSH:-1}" = "0" ] && exit 0
[ -f "$SDLC_HOME/env" ] && . "$SDLC_HOME/env"
[ -x "$SDLC_HOME/hooks/refresh-skills" ] && "$SDLC_HOME/hooks/refresh-skills" >/dev/null 2>&1

if ! command -v sdlc-gate >/dev/null 2>&1 || [ ! -f "$SDLC_HOME/repo/gate.config.yaml" ]; then
  echo "sdlc-gate: CLI or central repository not available; skipping local push gate." >&2
  exit 0
fi

FAILED=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ -z "${LOCAL_SHA:-}" ] && continue
  [ "$LOCAL_SHA" = "$ZERO" ] && continue          # branch deletion
  BRANCH="${LOCAL_REF#refs/heads/}"
  if [ "$REMOTE_SHA" != "$ZERO" ] && git cat-file -e "$REMOTE_SHA^{commit}" 2>/dev/null; then
    BASE="$REMOTE_SHA"
  else
    DEFAULT="$(git symbolic-ref -q --short "refs/remotes/$REMOTE_NAME/HEAD" 2>/dev/null || echo "$REMOTE_NAME/main")"
    BASE="$(git merge-base "$DEFAULT" "$LOCAL_SHA" 2>/dev/null || true)"
  fi
  REPORT="$(mktemp 2>/dev/null || echo "${TMPDIR:-/tmp}/sdlc-gate-$$.md")"
  ARGS=(run --config "$SDLC_HOME/repo/gate.config.yaml" --skills-dir "$SDLC_HOME/repo/skills"
        --head "$LOCAL_SHA" --ref "$BRANCH" --event-name local-push --output-md "$REPORT" --quiet)
  [ -n "$BASE" ] && ARGS+=(--base "$BASE")
  sdlc-gate "${ARGS[@]}"
  RC=$?
  if [ "$RC" = "1" ]; then
    cat "$REPORT" >&2
    echo "" >&2
    echo "sdlc-gate: push of $BRANCH blocked locally. Fix the findings or add SDLC-Skip trailers to the commit (skips are recorded)." >&2
    FAILED=1
  elif [ "$RC" != "0" ]; then
    echo "sdlc-gate: local gate could not run for $BRANCH (exit $RC); the server-side gate will enforce the policy." >&2
    [ "${SDLC_GATE_LOCAL_FAIL_CLOSED:-0}" = "1" ] && FAILED=1
  else
    echo "sdlc-gate: $BRANCH PASS" >&2
  fi
  rm -f "$REPORT"
done <<EOF
$INPUT
EOF

exit $FAILED
