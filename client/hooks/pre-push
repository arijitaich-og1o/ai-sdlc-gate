#!/usr/bin/env bash
# SDLC Gate — local push gate.
#
# For every branch being pushed, reviews the commits that are new to the remote with the intent derived from
# the branch name / trailers (release/*, hotfix/* -> deployment phases, ...). Managed installs fail closed.
# The server-side gate remains authoritative. Chains to the repository's own .git/hooks/pre-push if present.
set -u

REMOTE_NAME="$1"
ZERO="0000000000000000000000000000000000000000"
SDLC_HOME="${SDLC_GATE_HOME:-$HOME/.sdlc-gate}"
MANAGED="$(git config --system --get sdlc-gate.managed 2>/dev/null || true)"
PREFIX="$(git config --system --get sdlc-gate.prefix 2>/dev/null || true)"
REPO_DIR="$SDLC_HOME/repo"
GATE="sdlc-gate"
if [ "$MANAGED" = "true" ] && [ -n "$PREFIX" ] && [ -d "$PREFIX/repo" ]; then
  REPO_DIR="$PREFIX/repo"
  [ -x "$PREFIX/bin/sdlc-gate" ] && GATE="$PREFIX/bin/sdlc-gate"
fi
FAIL_CLOSED="${SDLC_GATE_LOCAL_FAIL_CLOSED:-0}"
[ "$MANAGED" = "true" ] && FAIL_CLOSED=1

INPUT="$(cat)"

LOCAL_HOOK="$(git rev-parse --git-path hooks 2>/dev/null)/pre-push"
if [ -x "$LOCAL_HOOK" ] && [ "$LOCAL_HOOK" != "$0" ]; then
  printf '%s\n' "$INPUT" | "$LOCAL_HOOK" "$@" || exit $?
fi

[ "$MANAGED" != "true" ] && [ "${SDLC_GATE_LOCAL_PUSH:-1}" = "0" ] && exit 0
[ -f "$SDLC_HOME/env" ] && . "$SDLC_HOME/env"
[ "$MANAGED" != "true" ] && [ -x "$SDLC_HOME/hooks/refresh-skills" ] && "$SDLC_HOME/hooks/refresh-skills" >/dev/null 2>&1

if ! command -v "$GATE" >/dev/null 2>&1 || [ ! -f "$REPO_DIR/gate.config.yaml" ] || [ -z "${LITELLM_API_KEY:-}" ]; then
  echo "sdlc-gate: engine, policy or LiteLLM key not available locally (run: sdlc-gate configure)." >&2
  [ "$FAIL_CLOSED" = "1" ] && exit 1
  echo "sdlc-gate: skipping local push gate; the server-side gate will enforce the policy." >&2
  exit 0
fi

FAILED=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ -z "${LOCAL_SHA:-}" ] && continue
  [ "$LOCAL_SHA" = "$ZERO" ] && continue          # branch deletion
  BRANCH="${LOCAL_REF#refs/heads/}"
  if [ "$REMOTE_SHA" != "$ZERO" ] && git cat-file -e "$REMOTE_SHA^{commit}" 2>/dev/null; then
    BASE="$REMOTE_SHA"
  else
    DEFAULT="$(git symbolic-ref -q --short "refs/remotes/$REMOTE_NAME/HEAD" 2>/dev/null || echo "$REMOTE_NAME/main")"
    BASE="$(git merge-base "$DEFAULT" "$LOCAL_SHA" 2>/dev/null || true)"
  fi
  REPORT="$(mktemp 2>/dev/null || echo "${TMPDIR:-/tmp}/sdlc-gate-$$.md")"
  ARGS=(run --config "$REPO_DIR/gate.config.yaml" --skills-dir "$REPO_DIR/skills"
        --head "$LOCAL_SHA" --ref "$BRANCH" --event-name local-push --output-md "$REPORT" --quiet)
  [ -n "$BASE" ] && ARGS+=(--base "$BASE")
  "$GATE" "${ARGS[@]}"
  RC=$?
  if [ "$RC" = "1" ]; then
    cat "$REPORT" >&2
    echo "" >&2
    echo "sdlc-gate: push of $BRANCH blocked locally. Fix the findings or add SDLC-Skip trailers to the commit (skips are recorded)." >&2
    FAILED=1
  elif [ "$RC" != "0" ]; then
    echo "sdlc-gate: local gate could not run for $BRANCH (exit $RC)." >&2
    [ "$FAIL_CLOSED" = "1" ] && FAILED=1
  else
    echo "sdlc-gate: $BRANCH PASS" >&2
  fi
  rm -f "$REPORT"
done <<EOF
$INPUT
EOF

exit $FAILED
