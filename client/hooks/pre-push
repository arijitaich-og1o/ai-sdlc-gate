#!/usr/bin/env bash
# AI SDLC Gate — local push gate.
#
# For every branch being pushed, reviews the commits that are new to the remote with the intent derived from
# the branch name / trailers (release/*, hotfix/* -> deployment phases, ...). Managed installs fail closed.
# Chains to the repository's own .git/hooks/pre-push if present.
set -u

REMOTE_NAME="$1"
ZERO="0000000000000000000000000000000000000000"
SDLC_HOME="${AI_SDLC_GATE_HOME:-$HOME/.ai-sdlc-gate}"
MANAGED="$(git config --system --get ai-sdlc-gate.managed 2>/dev/null || true)"
PREFIX="$(git config --system --get ai-sdlc-gate.prefix 2>/dev/null || true)"
REPO_DIR="$SDLC_HOME/repo"
# The engine lives in a private virtual environment; never depend on PATH inside hooks.
GATE=""
for cand in "$SDLC_HOME/venv/bin/ai-sdlc-gate" "$SDLC_HOME/venv/Scripts/ai-sdlc-gate.exe" "$HOME/.local/bin/ai-sdlc-gate"; do
  [ -x "$cand" ] && { GATE="$cand"; break; }
done
if [ "$MANAGED" = "true" ] && [ -n "$PREFIX" ] && [ -d "$PREFIX/repo" ]; then
  REPO_DIR="$PREFIX/repo"
  [ -x "$PREFIX/bin/ai-sdlc-gate" ] && GATE="$PREFIX/bin/ai-sdlc-gate"
fi
[ -n "$GATE" ] || GATE="$(command -v ai-sdlc-gate 2>/dev/null || true)"
[ -n "$GATE" ] || GATE="ai-sdlc-gate"
FAIL_CLOSED=1
[ "${AI_SDLC_GATE_LOCAL_FAIL_OPEN:-0}" = "1" ] && [ "$MANAGED" != "true" ] && FAIL_CLOSED=0

INPUT="$(cat)"

# Chain to the repository's own hooks (its .git/hooks or a project hooks path such as .husky) so nothing a team
# relies on is skipped. Our hooks path is enforced through GIT_CONFIG_PARAMETERS, which overrides repository settings.
LOCAL_DIR="$(git config --local --get core.hooksPath 2>/dev/null || true)"
if [ -n "$LOCAL_DIR" ]; then
  case "$LOCAL_DIR" in /*|[A-Za-z]:*|~*) ;; *) LOCAL_DIR="$(git rev-parse --show-toplevel 2>/dev/null)/$LOCAL_DIR";; esac
else
  LOCAL_DIR="$(git rev-parse --git-path hooks 2>/dev/null)"
fi
LOCAL_HOOK="$LOCAL_DIR/pre-push"
if [ -x "$LOCAL_HOOK" ] && [ "$(cd "$(dirname "$LOCAL_HOOK")" && pwd)" != "$(cd "$(dirname "$0")" && pwd)" ]; then
  printf '%s\n' "$INPUT" | "$LOCAL_HOOK" "$@" || exit $?
fi

[ "$MANAGED" != "true" ] && [ "${AI_SDLC_GATE_LOCAL_PUSH:-1}" = "0" ] && exit 0
[ "$MANAGED" != "true" ] && [ -x "$SDLC_HOME/hooks/refresh-skills" ] && "$SDLC_HOME/hooks/refresh-skills" >/dev/null 2>&1

if ! { [ -x "$GATE" ] || command -v "$GATE" >/dev/null 2>&1; } || [ ! -f "$REPO_DIR/gate.config.yaml" ] || ! "$GATE" configure --check --config "$REPO_DIR/gate.config.yaml" >/dev/null 2>&1; then
  echo "ai-sdlc-gate: the review engine is not set up (run: ai-sdlc-gate configure)." >&2
  [ "$FAIL_CLOSED" = "1" ] && exit 1
  echo "ai-sdlc-gate: fail-open mode; continuing without a review." >&2
  exit 0
fi

FAILED=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ -z "${LOCAL_SHA:-}" ] && continue
  [ "$LOCAL_SHA" = "$ZERO" ] && continue          # branch deletion
  BRANCH="${LOCAL_REF#refs/heads/}"
  if [ "$REMOTE_SHA" != "$ZERO" ] && git cat-file -e "$REMOTE_SHA^{commit}" 2>/dev/null; then
    BASE="$REMOTE_SHA"
  else
    DEFAULT="$(git symbolic-ref -q --short "refs/remotes/$REMOTE_NAME/HEAD" 2>/dev/null || echo "$REMOTE_NAME/main")"
    BASE="$(git merge-base "$DEFAULT" "$LOCAL_SHA" 2>/dev/null || true)"
  fi
  REPORT="$(mktemp 2>/dev/null || echo "${TMPDIR:-/tmp}/ai-sdlc-gate-$$.md")"
  REPORT_JSON="$REPORT.json"
  REPO_SLUG="$(git remote get-url "$REMOTE_NAME" 2>/dev/null | sed -E 's#.*github\.com[:/]##; s#\.git$##')"
  ARGS=(run --config "$REPO_DIR/gate.config.yaml" --skills-dir "$REPO_DIR/skills"
        --head "$LOCAL_SHA" --ref "$BRANCH" --event-name local-push --repo "$REPO_SLUG" --output-md "$REPORT" --output-json "$REPORT_JSON" --quiet)
  [ -n "$BASE" ] && ARGS+=(--base "$BASE")
  "$GATE" "${ARGS[@]}"
  RC=$?
  [ -f "$REPORT_JSON" ] && "$GATE" emit-metrics --config "$REPO_DIR/gate.config.yaml" --report "$REPORT_JSON" --dispatch >/dev/null 2>&1 || echo "ai-sdlc-gate: run not recorded in metrics (no GitHub credential available)." >&2
  if [ "$RC" = "1" ]; then
    cat "$REPORT" >&2
    echo "" >&2
    echo "ai-sdlc-gate: push of $BRANCH blocked locally. Fix the findings or add SDLC-Skip trailers to the commit (skips are recorded)." >&2
    FAILED=1
  elif [ "$RC" != "0" ]; then
    echo "ai-sdlc-gate: local gate could not run for $BRANCH (exit $RC)." >&2
    [ "$FAIL_CLOSED" = "1" ] && FAILED=1
  else
    echo "ai-sdlc-gate: $BRANCH PASS" >&2
  fi
  rm -f "$REPORT" "$REPORT_JSON"
done <<EOF
$INPUT
EOF

exit $FAILED
