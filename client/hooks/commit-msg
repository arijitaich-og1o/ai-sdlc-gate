#!/usr/bin/env bash
# AI SDLC Gate — local commit gate.
#
# Reviews the staged change with the organisation skills and policy, using the commit message
# for intent and skip trailers, then stamps the message with an `AI-SDLC-Gate-Client` attestation carrying the
# developer's verified identity. In managed installs (system gitconfig ai-sdlc-gate.managed=true) the hook fails
# closed and requires a verified identity. The GitHub check remains the authoritative enforcement point.
set -u

MSG_FILE="$1"
SDLC_HOME="${AI_SDLC_GATE_HOME:-$HOME/.ai-sdlc-gate}"
MANAGED="$(git config --system --get ai-sdlc-gate.managed 2>/dev/null || true)"
PREFIX="$(git config --system --get ai-sdlc-gate.prefix 2>/dev/null || true)"
REPO_DIR="$SDLC_HOME/repo"
# The engine lives in a private virtual environment; never depend on PATH inside hooks.
GATE=""
for cand in "$SDLC_HOME/venv/bin/ai-sdlc-gate" "$SDLC_HOME/venv/Scripts/ai-sdlc-gate.exe" "$HOME/.local/bin/ai-sdlc-gate"; do
  [ -x "$cand" ] && { GATE="$cand"; break; }
done
if [ "$MANAGED" = "true" ] && [ -n "$PREFIX" ] && [ -d "$PREFIX/repo" ]; then
  REPO_DIR="$PREFIX/repo"
  [ -x "$PREFIX/bin/ai-sdlc-gate" ] && GATE="$PREFIX/bin/ai-sdlc-gate"
fi
[ -n "$GATE" ] || GATE="$(command -v ai-sdlc-gate 2>/dev/null || true)"
[ -n "$GATE" ] || GATE="ai-sdlc-gate"
FAIL_CLOSED=1
[ "${AI_SDLC_GATE_LOCAL_FAIL_OPEN:-0}" = "1" ] && [ "$MANAGED" != "true" ] && FAIL_CLOSED=0

# Chain to the repository's own hooks (its .git/hooks or a project hooks path such as .husky) so nothing a team
# relies on is skipped. Our hooks path is enforced through GIT_CONFIG_PARAMETERS, which overrides repository settings.
LOCAL_DIR="$(git config --local --get core.hooksPath 2>/dev/null || true)"
if [ -n "$LOCAL_DIR" ]; then
  case "$LOCAL_DIR" in /*|[A-Za-z]:*|~*) ;; *) LOCAL_DIR="$(git rev-parse --show-toplevel 2>/dev/null)/$LOCAL_DIR";; esac
else
  LOCAL_DIR="$(git rev-parse --git-path hooks 2>/dev/null)"
fi
LOCAL_HOOK="$LOCAL_DIR/commit-msg"
if [ -x "$LOCAL_HOOK" ] && [ "$(cd "$(dirname "$LOCAL_HOOK")" && pwd)" != "$(cd "$(dirname "$0")" && pwd)" ]; then
  "$LOCAL_HOOK" "$@" || exit $?
fi

[ "$MANAGED" != "true" ] && [ -x "$SDLC_HOME/hooks/refresh-skills" ] && "$SDLC_HOME/hooks/refresh-skills" >/dev/null 2>&1

if ! { [ -x "$GATE" ] || command -v "$GATE" >/dev/null 2>&1; } || [ ! -f "$REPO_DIR/gate.config.yaml" ]; then
  echo "ai-sdlc-gate: engine or policy not available locally." >&2
  if [ "$FAIL_CLOSED" = "1" ]; then echo "ai-sdlc-gate: blocking the commit until the client is repaired (re-run the installer or contact IT)." >&2; exit 1; fi
  echo "ai-sdlc-gate: fail-open mode; continuing without a review." >&2
  exit 0
fi

CONFIG="$REPO_DIR/gate.config.yaml"

# Identity: required by policy once the identity provider is configured; always strict in managed mode.
REQ_FLAG="--require-identity"
STRICT=""
[ "$MANAGED" = "true" ] && STRICT="--strict"
if ! "$GATE" identity check --config "$CONFIG" $STRICT >/dev/null 2>&1; then
  echo "ai-sdlc-gate: a verified identity is required. Run:  ai-sdlc-gate identity login" >&2
  exit 1
fi

if ! "$GATE" configure --check --config "$CONFIG" >/dev/null 2>&1; then
  echo "ai-sdlc-gate: the review engine is not set up. Run:  ai-sdlc-gate configure" >&2
  if [ "$FAIL_CLOSED" = "1" ]; then exit 1; fi
  exit 0
fi

LAST_DIR="${AI_SDLC_GATE_HOME:-$HOME/.ai-sdlc-gate}"; mkdir -p "$LAST_DIR"
REPORT="$LAST_DIR/last-report.md"; REPORT_JSON="$LAST_DIR/last-report.json"; REPORT_TXT="$LAST_DIR/last-report.txt"
"$GATE" run --staged --config "$CONFIG" --skills-dir "$REPO_DIR/skills" \
  --pr-body-file "$MSG_FILE" --event-name local-commit --repo "$(git remote get-url origin 2>/dev/null | sed -E 's#.*github\.com[:/]##; s#\.git$##')" \
  --output-md "$REPORT" --output-json "$REPORT_JSON" --output-text "$REPORT_TXT" --quiet
RC=$?
[ -f "$REPORT_JSON" ] && "$GATE" emit-metrics --config "$CONFIG" --report "$REPORT_JSON" --dispatch >/dev/null 2>&1 || echo "ai-sdlc-gate: run not recorded in metrics (no GitHub credential available)." >&2

case "$RC" in
  0)
    RESULT="pass"
    grep -q "^SDLC-Skip:" "$MSG_FILE" 2>/dev/null && RESULT="waived"
    "$GATE" attest --config "$CONFIG" --message-file "$MSG_FILE" --result "$RESULT" --quiet $REQ_FLAG || { RC=$?; echo "ai-sdlc-gate: attestation failed (exit $RC)." >&2; }
    [ "$RC" = 0 ] && echo "ai-sdlc-gate: PASS ($RESULT)" >&2
    ;;
  1)
    echo ""
    cat "$REPORT_TXT" 2>/dev/null || cat "$REPORT" >&2
    echo ""
    echo "ai-sdlc-gate: commit blocked." >&2
    ;;
  *)
    echo "ai-sdlc-gate: the local gate could not run (exit $RC)." >&2
    if [ "$FAIL_CLOSED" = "1" ]; then
      echo "ai-sdlc-gate: fail-closed mode, blocking the commit." >&2
    else
      echo "ai-sdlc-gate: fail-open mode; continuing without a review." >&2
      RC=0
    fi
    ;;
esac
exit $RC
